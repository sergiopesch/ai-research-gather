# Local server
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:8080
ARXIV_USER_AGENT=

# Safe local fallback
AI_DEMO_MODE=true

# Hosted public studio
PUBLIC_AI_ENABLED=true
PUBLIC_SCRIPT_LIMIT_PER_DAY=1
AI_GATEWAY_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Private hosted owner session: generate with `npm run owner:secrets`
OWNER_ACCESS_KEY_HASH=
SESSION_SECRET=

# Local authenticated ChatGPT and Grok CLI bridges
LOCAL_SUBSCRIPTIONS_ENABLED=true

# Direct script and speech providers
