{
  "name": "sergio-peschiera-research-notebook",
  "private": true,
  "version": "1.0.0",
  "description": "A multi-model AI studio for turning research papers into grounded conversations and generated voices.",
  "author": {
    "name": "Sergio Peschiera",
    "url": "https://www.sergiopesch.com/"
  },
  "homepage": "https://ai-research-gather.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/sergiopesch/ai-research-gather.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:client": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check:ci": "npm run audit:dependencies && npm run eval:scripts -- --mock && npm run check",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "eval:scripts": "tsx evals/run-script-eval.ts",
    "lint": "eslint .",
    "preview": "npm run build && tsx server/index.ts",
    "start": "tsx server/index.ts",
    "healthcheck": "node scripts/healthcheck.mjs",
    "owner:secrets": "node scripts/generate-owner-secrets.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.18",
    "@ai-sdk/deepgram": "^3.0.12",
    "@ai-sdk/elevenlabs": "^3.0.13",
    "@ai-sdk/google": "^4.0.21",
    "@ai-sdk/lmnt": "^3.0.12",
    "@ai-sdk/openai": "^4.0.17",
    "@ai-sdk/xai": "^4.0.18",
    "@radix-ui/react-toast": "^1.2.1",
    "@upstash/redis": "^1.38.0",
    "ai": "^7.0.34",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.462.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "tsx": "^4.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "nanoid": "^3.3.8",
    "picomatch": "^2.3.2",
    "rollup": "^4.60.1",
    "yaml": "^2.8.3",
    "vite": {
      "esbuild": "^0.25.0"
    },
    "body-parser": "2.3.0",
    "qs": "6.15.3",
    "js-yaml": "4.3.0"
  }
}
